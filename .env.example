# Copy to .env (never commit it) and adjust. All values are optional unless marked REQUIRED.

# --- Django ---
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(60))"
# (also seeds the derived gallery passwords: changing it later invalidates them)
SECRET_KEY=
DEBUG=false
# Public URL of the site, without trailing slash (used in e-mail links, CSRF and secure cookies)
SITE_URL=https://wedding.example.org
# Comma separated host names the site answers to
ALLOWED_HOSTS=wedding.example.org
# Extra trusted origins (defaults to SITE_URL when it is https)
#CSRF_TRUSTED_ORIGINS=
# Where the SQLite file lives (the container uses /data/db.sqlite3)
#DB_PATH=/data/db.sqlite3
# Directory with the private overlay: templates/ and static/ that override the defaults
#SITE_CONTENT_DIR=/content
#LOG_LEVEL=INFO
#LANGUAGE_CODE=fr-fr
#TIME_ZONE=Europe/Paris

# --- Access ---
# Phrase that lets people without a personal link create an account (they see no event details);
# registration is disabled when empty
REGISTRATION_CODE=

# --- Site identity ---
SITE_TITLE=Notre mariage
COUPLE_NAMES=Alex et Sam
# Free text shown on the RSVP page and in the invitation e-mail, e.g. "15 mai"
RSVP_DEADLINE=
# Optional link to a gift pot (shows the default "Cadeaux" section)
GIFT_POT_URL=
# Hero image at the top of the web page, path relative to a static dir, e.g. wedding/hero.jpg (empty = none)
HEADER_IMAGE=
# cover (fill and crop) or contain (show the whole image on black)
HEADER_IMAGE_FIT=cover
# Images embedded in the e-mails (same kind of path; empty = none). Templates in the overlay can embed more
# with {% email_image 'path' %}.
EMAIL_HERO_IMAGE=
EMAIL_HEADER_IMAGE=
# E-mail subjects; {event} is replaced by the name of the event
#SAVE_THE_DATE_SUBJECT=Save the date - {event}
#INVITATION_SUBJECT=Invitation - {event}
#PREPARATION_SUBJECT=Quelques précisions - {event}
#THANK_YOU_SUBJECT=Merci ! - {event}

# --- E-mail (SMTP) ---
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# From header, e.g. "Alex & Sam <alex@example.org>"
DEFAULT_FROM_EMAIL=
REPLY_TO_EMAIL=
# Comma separated addresses put in copy of every campaign e-mail
CC_LIST=

# --- Photo gallery (optional, Lychee) ---
# Public base URL of the gallery on the same host as the site, e.g. https://wedding.example.org/photos
# The "Photos" link, the gallery log-in and the photo buttons of the e-mails are hidden when empty.
LYCHEE_URL=
# Address used by the server to reach the gallery API (defaults to LYCHEE_URL), e.g. http://192.168.1.20
#LYCHEE_API_URL=
# Gallery administrator, used by `manage.py sync_lychee_users` to create one account per guest
LYCHEE_ADMIN_USER=
LYCHEE_ADMIN_PASSWORD=
