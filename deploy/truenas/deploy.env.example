# Copy to deploy/truenas/deploy.private.env (git-ignored) and adjust.
APP_DIR=/mnt/POOL/apps/wedding
SITE_HOST=wedding.example.org
# Dedicated address of the web front end on your LAN (macvlan): must be free, outside the DHCP range.
LAN_IP=192.168.1.59
LAN_PARENT=eno1
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# Set by the deploy step (git short sha of the image built on the NAS)
# Uncomment to test with the Let's Encrypt staging CA first
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
APP_TAG=local
